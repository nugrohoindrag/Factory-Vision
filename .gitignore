# Node & Dependencies
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.dist/
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.*.local

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Test coverage & logs
coverage/
*.log
.temp/
.cache/

# Font vendoring keeps the full source font only while it subsets.
packages/ui/src/fv/fonts/.material-symbols-full.woff2

# Scratch space used while vendoring fonts.
.tmp-fonts/

# Product documentation and internal notes are kept out of the public
# repository: the PRD, market analysis and roadmap are commercial material,
# and Docs/Daftar-Akses-*.xlsx holds live credentials in plaintext.
Docs/

# Local agent configuration, machine-specific.
.claude/

# Python bytecode from local helper scripts.
__pycache__/
*.pyc

# Order source documents written by DocumentStorage. The bytes live on a mounted
# volume in a deployment (DOCUMENT_STORAGE_DIR); locally they land here.
var/

# Browser QA evidence (screenshots, contrast report). Regenerated by
# `pnpm qa:themes` and `pnpm qa:pwa`; not source.
qa-evidence/

# Local database dumps taken before a risky migration. They can hold real
# production data, so they never belong in the repository.
.backup/

# Vite writes this beside the config while it loads a TypeScript config file.
*.timestamp-*.mjs
