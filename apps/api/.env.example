# Factory Vision API — the variable names are unchanged from the previous
# implementation, so a deploy/.env written for the old container works as is.
NODE_ENV=development
PORT=4000
TZ=Asia/Jakarta

# Connect as the RLS-bound application role, never as the schema owner.
DATABASE_URL=postgresql://factory_app:factory_app_password@localhost:5432/factory_vision
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
SLOW_QUERY_MS=250

AUTH_REQUIRED=true
DEPLOYMENT_MODE=ON_PREMISE_SINGLE_TENANT
DEFAULT_TENANT_ID=tenant-pilot-factory-01
CORS_ALLOWED_ORIGINS=

BOOTSTRAP_ADMIN_EMAIL=admin@pabrik.co.id
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
# The vendor console's first administrator (/api/internal/v1). No internal
# account ships with a password; unset means the console has no way in.
INTERNAL_ADMIN_EMAIL=
INTERNAL_ADMIN_PASSWORD=
INTERNAL_ADMIN_NAME=Internal Administrator
BOOTSTRAP_OPERATOR_PIN=

MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=ADMIN
PASSWORD_MIN_LENGTH=12
PIN_MIN_LENGTH=6
SECURITY_ALERT_WEBHOOK=
LARGE_EXPORT_ROWS=5000
# WIP aging thresholds (Improvement PRD 7.4), in hours.
WIP_AGING_HOURS=24
WIP_CRITICAL_HOURS=72

# Planning job queue (planning_job, SKIP LOCKED). The API runs the runner
# unless this is false and `fv worker` owns the queue.
API_RUN_JOB_RUNNER=true
PLANNING_JOB_INTERVAL_MS=5000
# Outbox relay feeding the SSE stream (GET /api/v1/events/stream).
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000

# Order documents: filesystem (single VPS) or s3/minio (path-style).
OBJECT_STORAGE_DRIVER=filesystem
DOCUMENT_STORAGE_DIR=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Metrics and pprof; never publish this port.
ADMIN_ADDR=127.0.0.1:4100
# Set to an OTLP/HTTP collector to enable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
