{
  "name": "@factory-vision/api-go",
  "version": "0.1.0",
  "private": true,
  "description": "Factory Vision MES API, Go implementation (replaces apps/api at cutover).",
  "scripts": {
    "build:go": "go build -trimpath -o bin/fv ./cmd/fv",
    "dev:go": "go run ./cmd/fv serve",
    "vet": "go vet ./...",
    "test:go": "go test ./...",
    "test:integration": "go test -tags integration ./...",
    "fixtures": "node --import tsx ../api/scripts/export-go-fixtures.mjs"
  }
}
