# Factory Vision API (Go) — the variable names are the Node API's, so a
# deploy/.env written for the old container works unchanged.
NODE_ENV=development
PORT=4000
TZ=Asia/Jakarta

# Connect as the RLS-bound application role, never as the schema owner.
DATABASE_URL=postgresql://factory_app:factory_app_password@localhost:5432/factory_vision
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
SLOW_QUERY_MS=250

AUTH_REQUIRED=true
DEPLOYMENT_MODE=ON_PREMISE_SINGLE_TENANT
DEFAULT_TENANT_ID=tenant-pilot-factory-01
CORS_ALLOWED_ORIGINS=

BOOTSTRAP_ADMIN_EMAIL=admin@pabrik.co.id
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_OPERATOR_PIN=

MFA_ENCRYPTION_KEY=
MFA_REQUIRED_ROLES=ADMIN
PASSWORD_MIN_LENGTH=12
PIN_MIN_LENGTH=6
SECURITY_ALERT_WEBHOOK=
LARGE_EXPORT_ROWS=5000
# WIP aging thresholds (Improvement PRD 7.4), in hours.
WIP_AGING_HOURS=24
WIP_CRITICAL_HOURS=72

# Metrics and pprof; never publish this port.
ADMIN_ADDR=127.0.0.1:4100
# Set to an OTLP/HTTP collector to enable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
