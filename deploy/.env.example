# Factory Vision, deployment configuration
#
# Copy to deploy/.env and fill in before running docker compose.
# Nothing here has a usable default for secrets: an install that silently
# starts with a known password is worse than one that refuses to start.

# --- Database ------------------------------------------------------
# POSTGRES_USER owns the schema and runs migrations. It is a superuser, which
# means it BYPASSES row-level security, so the API must not connect as it.
POSTGRES_USER=factory
POSTGRES_PASSWORD=
POSTGRES_DB=factory_vision

# The role the API actually connects as: NOSUPERUSER, NOBYPASSRLS, so the
# tenant_isolation policies on every tenant-scoped table apply to its queries.
# Created NOLOGIN by migration 004; `pnpm db:migrate` gives it this password.
# Without it the API would connect as the superuser and tenant isolation would
# not be enforced at the database layer at all.
APP_DB_USER=factory_app
APP_DB_PASSWORD=

# --- Deployment mode -------------------------------------
# ON_PREMISE_SINGLE_TENANT, one factory, one tenant, inside their network.
# CLOUD_MULTI_TENANT, hosted, tenant resolved per request.
DEPLOYMENT_MODE=ON_PREMISE_SINGLE_TENANT
DEFAULT_TENANT_ID=tenant-pilot-factory-01

# --- Security ------------------------------------------------------
# Leave true. Setting it to false disables authentication and the access
# control checks on every endpoint, and is intended only for local development.
AUTH_REQUIRED=true

# The first administrator. No account ships with a password, so until both of
# these are set nobody can sign in, deliberately: a built-in default password
# on an internet-facing deployment is compromised the moment anyone recognises
# the product. Minimum 12 characters; the API refuses anything shorter.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional shared starting PIN for the shop-floor terminals (6-12 digits, and
# not a repeated or sequential run). It is a starting point only: clear it once
# every operator has been issued their own PIN.
# Leave blank to require an administrator to issue each operator their own PIN
# from Settings before they can sign in.
BOOTSTRAP_OPERATOR_PIN=

# --- Internal admin console ----------------------------------------
# The vendor's own client management, served at /api/internal/v1 and reachable
# only with an internal session. It needs DATABASE_URL: a customer record that
# vanishes on restart is worse than none. Without these two set, the admin
# console has no way in, which is deliberate.
INTERNAL_ADMIN_EMAIL=
INTERNAL_ADMIN_PASSWORD=
INTERNAL_ADMIN_NAME=Internal Administrator

# --- Demo dataset --------------------------------------------------
# Loads the demo tyre plant: master data plus 60 days of shop-floor history.
# Leave unset for a real factory, which should start empty and be filled from
# its own master data. Set to true for a sales or pilot deployment that needs
# something on screen from the first login.
SEED_DEMO_DATA=

# --- Images --------------------------------------------------------
# What `docker compose pull` fetches. CI publishes a tag per branch, so
# IMAGE_TAG is master / staging / production, or a v* release tag.
IMAGE_PREFIX=ghcr.io/nugrohoindrag
IMAGE_TAG=production

# --- Networking ----------------------------------------------------
# The public marketing site. It is the apex host, so it has no subdomain of its
# own — LANDING_DOMAIN below is the bare domain.
LANDING_PORT=3000
CONSOLE_PORT=3100
OPERATOR_PORT=3200
# The internal admin console is a vendor tool, not a customer surface, so it
# binds to loopback by default. Reach it over an SSH tunnel rather than
# publishing it.
ADMIN_PORT=3300
ADMIN_BIND=127.0.0.1

# On a public VPS set WEB_BIND=127.0.0.1 so only the reverse proxy is exposed
# (§12: publish 22/80/443 and nothing else). On a plant LAN leave it as is so
# tablets can reach the operator terminal directly.
WEB_BIND=0.0.0.0

# --- Public edge (docker compose --profile proxy) -------------------
# Only needed for an internet-facing VPS. Traefik terminates HTTPS on :443,
# redirects HTTP, and obtains Let's Encrypt certificates itself. Each domain
# must already resolve to this host or the ACME challenge fails.
ACME_EMAIL=
# The apex, and the www that redirects to it. Both need to resolve to this host
# before Let's Encrypt will issue for either.
LANDING_DOMAIN=example.com
LANDING_WWW_DOMAIN=www.example.com
DASHBOARD_DOMAIN=dashboard.example.com
OPERATOR_DOMAIN=operator.example.com
API_DOMAIN=api.example.com
# Publishing the internal admin console needs a deliberate decision.
ADMIN_PUBLIC=false
ADMIN_DOMAIN=admin.example.com

# --- Security policy -----------------------------------------------
# Cross-origin allowlist for the API and the realtime channel. Leave empty when
# the front ends are served from the same origin through the reverse proxy,
# which is the default shape: empty means no cross-origin access at all in
# production. Set it only when a console is hosted on its own domain.
# Example: https://dashboard.example.com,https://operator.example.com
CORS_ALLOWED_ORIGINS=

# Multi-factor authentication (§5). MFA_ENCRYPTION_KEY protects the stored TOTP
# secrets: without it enrolment refuses to start, because a secret that a
# database dump hands over is not a second factor. Use 32+ random characters,
# keep it out of the database host's backups, and rotating it invalidates every
# existing enrolment (users re-enrol).
MFA_ENCRYPTION_KEY=
# Roles that must carry a second factor. They can still sign in without one —
# otherwise there would be no way to enrol — but the console sends them
# straight to enrolment and the state is visible to an administrator.
MFA_REQUIRED_ROLES=ADMIN

# Credential policy, applied on every path that sets a password or a PIN.
# These are minimums; raising them is supported, lowering them is not.
PASSWORD_MIN_LENGTH=12
PIN_MIN_LENGTH=6

# --- Security monitoring (§42, §43) -------------------------------------
# Where alertable events go: a lockout, an administrator role handed out, a
# permission change, a bulk export, an audit write failure, a failed backup.
# A Slack or Teams incoming webhook works as is; so does any endpoint that
# accepts JSON. Leave empty and the events are still written to the log as
# structured lines, which is what a log shipper or SIEM reads.
SECURITY_ALERT_WEBHOOK=
# Rows in one export before it counts as bulk and raises an alert.
LARGE_EXPORT_ROWS=5000

# --- Backup --------------------------------------------------------
# The `backup` service runs deploy/backup.sh on this interval and prunes
# anything older than the retention window.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
# Encrypts the dump with AES-256. Required for any backup that leaves the
# plant, and the passphrase must be stored somewhere other than this host.
BACKUP_PASSPHRASE=
# Optional shell command run after a successful backup, for the offsite copy:
# rsync, rclone, aws s3 sync, or whatever the customer already operates.
BACKUP_OFFSITE_CMD=

# Restore verification (§41). The newest dump is restored into a throwaway
# database and checked for rows, on this interval. A backup that has never been
# restored is a hope, not a control.
BACKUP_VERIFY_INTERVAL_SECONDS=604800
BACKUP_VERIFY_DB=factory_vision_restore_check
# Alert if the newest backup is older than this, i.e. the schedule has stopped.
BACKUP_MAX_AGE_HOURS=48

# --- Locale --------------------------------------------------------
TZ=Asia/Jakarta

# --- Planning -------------------------------------------------------------
# How often the planning queue is drained: demand forecast generation and
# capacity recalculation run as jobs, never inside an HTTP request.
PLANNING_JOB_INTERVAL_MS=5000

# The planning queue runs in the worker container. The API can run it too —
# `SKIP LOCKED` means both is safe — but leaving it off is what makes the split
# real. Set to true only for a single-container install with no worker.
API_RUN_JOB_RUNNER=false

# How often the outbox relay publishes planning events over WebSocket. This one
# runs in the API, because that is where the socket connections are.
OUTBOX_RELAY_INTERVAL_MS=5000

# --- Document storage (ADR-09) --------------------------------------------
# Where Customer Order attachments go. `filesystem` writes to the document-data
# volume and is correct while there is exactly one API container.
#
# Switch to `s3` before running a second API replica: two replicas on local
# volumes each hold half the attachments, which shows up only as intermittent
# 404s on documents that were uploaded successfully. `s3` works against MinIO
# (start the `minio` profile) or any managed S3 bucket.
OBJECT_STORAGE_DRIVER=filesystem

# Only read when OBJECT_STORAGE_DRIVER=s3. Leave the endpoint empty for AWS;
# set it to http://minio:9000 for the bundled MinIO service. The API refuses to
# start with a half-filled configuration rather than failing on first upload.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=factory-vision-documents
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
