# Factory Vision — MES API (US-052 Cloud SaaS, US-053 On-Premise)
#
# One image serves both deployment modes. The difference is configuration, not
# code: PRD §31 requires the domain model and business behaviour to be
# identical, so an on-premise install must not run a different build.
#
# One binary, four roles, selected by the command:
#
#   serve        the HTTP API (default)
#   worker       the planning job queue and the outbox relay, no HTTP
#   migrate      apply db/migrations (and db/seeds when SEED_DEMO_DATA is on)
#   seed-demo    the demo plant and its shop-floor history, idempotent

# --- Build stage ---------------------------------------------------
FROM golang:1.26-alpine AS build

WORKDIR /src

# Module manifests first, so the dependency download is cached across
# source edits — the layer that dominates rebuild time.
COPY apps/api/go.mod apps/api/go.sum ./
RUN go mod download

COPY apps/api ./

# CGO off and trimmed paths: a static binary that runs on a distroless base,
# with no build-machine paths in its panics.
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/fv ./cmd/fv

# The attachment directory, so it exists in the image owned by the runtime
# user: Docker seeds a fresh named volume from the image's directory,
# ownership included, and the process has no root and no shell to fix one up.
RUN mkdir -p /out/documents

# --- Runtime stage -------------------------------------------------
#
# distroless/static carries no shell, no package manager and no libc: the
# image scan has nothing to find, and there is nothing for an attacker to
# run. Time zones are compiled into the binary (time/tzdata), so TZ=Asia/Jakarta
# resolves without an OS zoneinfo directory. The image already runs as a
# non-root user: never run the API as root, an on-premise install often lands
# on shared factory infrastructure where that matters more, not less.
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

ENV PORT=4000
ENV NODE_ENV=production

COPY --from=build /out/fv /fv

# The schema travels with the image: a VPS that pulls images has no checkout,
# so `pnpm db:migrate` is not available to it. `fv migrate` applies it.
COPY db /db
ENV MIGRATIONS_DIR=/db

# Customer Order attachments on the filesystem driver (compose mounts the
# document-data volume here). A volume created by an earlier image under
# another uid needs a one-off `chown 65532:65532` — RUNBOOK-DEPLOY.md §10.
COPY --from=build --chown=65532:65532 /out/documents /var/lib/factory-vision/documents

EXPOSE 4000

# No curl in distroless: the binary probes itself.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/fv", "healthcheck"]

ENTRYPOINT ["/fv"]
CMD ["serve"]
